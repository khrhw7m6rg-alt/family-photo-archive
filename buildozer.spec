[app]

title = Family Photo Archive
package.name = familyphotoarchive
package.domain = org.tamerdaoud

source.dir = .
source.include_exts = py,png,jpg,jpeg,webp

version = 1.0

requirements = python3,kivy,plyer

orientation = portrait

fullscreen = 0

android.permissions = READ_MEDIA_IMAGES,READ_MEDIA_VIDEO

[buildozer]

log_level = 2
warn_on_root = 1
